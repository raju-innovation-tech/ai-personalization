# --- App ---
APP_NAME=AI Personalization & Offer Engine
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=545dAtYkteMAyEgxI73YCsn42qcUx3HPs1ckfNQBcYXJpw0wc7QTMRMx_6XgLgzgNSvR1r_3tAvzZBCkSEwCXA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# In docker-compose, host is "postgres"; running locally without Docker, use "localhost"
DATABASE_URL=postgresql+asyncpg://raju:raju-dev-708433@postgres:5432/ai_personalization
DATABASE_URL_SYNC=postgresql+psycopg2://raju:raju-dev-708433@postgres:5432/ai_personalization
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=900

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5000,http://127.0.0.1
# Any port on localhost/127.0.0.1 is also allowed by default (Flutter web uses a random port).
# Override only if you need something different:
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# --- Rate limiting ---
EVENTS_RATE_LIMIT_PER_MINUTE=600

# --- Recommendation engine (Phase 2) ---
RECO_LOOKBACK_DAYS=90
RECO_HALF_LIFE_DAYS=30
RECO_SNAPSHOT_TTL_SECONDS=300
RECO_EXCLUDE_OUT_OF_STOCK=true
RECO_FBT_MIN_SUPPORT=2

# --- Customer intelligence (Phase 3) ---
CUSTOMER_LOOKBACK_DAYS=365
CUSTOMER_ACTIVE_DAYS=30
# Automatic profile/segment refresh every N minutes (0 = only when someone presses Recompute)
CUSTOMER_PROFILE_REFRESH_MINUTES=60

# --- First super admin bootstrap (seed script only) ---
FIRST_SUPER_ADMIN_EMAIL=admin@example.com
FIRST_SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- LLM (optional, not used yet) ---
ANTHROPIC_API_KEY=

# --- Welfog sync (python -m scripts.welfog_sync) - see docs/WELFOG_INTEGRATION.md ---
# Use READ-ONLY database users. Passwords go here only, never in code or git.
# WELFOG_MYSQL_URL=mysql+pymysql://ai_engine_ro:CHANGE_ME@mysql-host:3306/welfog_db?charset=utf8mb4
# WELFOG_PG_URL=postgresql+psycopg2://ai_engine_ro:CHANGE_ME@pg-host:5432/welfog_db
# Where the engine API is, and a service account (ADMIN role) for the product catalogue upload
# AI_ENGINE_URL=http://localhost:8000/api/v1
# AI_ENGINE_EMAIL=ai-sync@yourcompany.com
# AI_ENGINE_PASSWORD=CHANGE_ME
# Timezone of Welfog's naive DATETIME/TIMESTAMP columns (UTC, or e.g. Asia/Kolkata). CONFIRM WITH WELFOG.
# WELFOG_SOURCE_TZ=UTC
# Base URL of Welfog's product images (relative paths like 1649/xyz.webp are joined to it)
# WELFOG_IMAGE_BASE_URL=https://cdn.welfog.example/uploads
# UTC moment the tracking SQL (user_events + triggers) went live, WITH offset - avoids double counting carts/wishlists
# WELFOG_EVENTS_TABLE_START=2026-11-10T08:00:00+00:00
# WELFOG_SYNC_STATE=welfog_sync_state.json



